{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "sourceMap": true
  },
  "include": ["model/**/*", "policy/**/*", "capability/**/*", "executor/**/*", "diff/**/*", "verify/**/*", "cli/**/*"],
  "exclude": ["node_modules", "dist"]
}
